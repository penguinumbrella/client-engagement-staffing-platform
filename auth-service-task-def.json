        { "name": "EUREKA_URL", "value": "http://3.89.117.185:8761/eureka/" },
        { "name": "GOOGLE_CLIENT_ID", "value": "38937227592-e7cp4s6g39e50f202tgm8mhi74bdlt51.apps.googleusercontent.com" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:397345411365:secret:auth-service-test/db-password-SMXrVT" },
