          }
        },
        {
          "name": "[Check] Client via Gateway -> 404 (Client Service not yet implemented)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayBaseUrl}}/client/api/clients" }
          }
        },
        {
          "name": "[Check] Eureka Registry Snapshot (confirms STAFFING/ENGAGEMENT/CLIENT are all UP)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "http://localhost:8761/eureka/apps" }
          }
        }
      ]
    }
  ]
}
